# OneNet proxy environment example

# OneNet device id (from OneNet console)
ONENET_DEVICE_ID=your_device_id_here

# OneNet access key (DO NOT commit real keys to repo)
ONENET_ACCESS_KEY=your_access_key_here

# Header name OneNet expects for the key. Default is "api-key".
# If your OneNet console says use "access-key", set that here.
ONENET_KEY_NAME=api-key

# Optional simple secret token that the frontend should send in x-secret header
# This is NOT a replacement for real auth, just a lightweight guard.
SECRET_TOKEN=your_frontend_secret

# Server port
PORT=3000
